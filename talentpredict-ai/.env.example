# --- LLM provider (choose one) ---
# Option A: Ollama (local, no key required)
ANTHROPIC_BASE_URL=http://localhost:11434/v1
ANTHROPIC_MODEL=llama3.2:latest
# ANTHROPIC_API_KEY can be empty or any value when using Ollama

# Option B: Anthropic native API (use Anthropic API key)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: GitHub personal access token (increases rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# Optional: Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# --- AI cache database (PostgreSQL) ---
# Option A: full URL (takes priority)
# AI_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/talentpredict_ai

# Option B: individual vars (used when AI_DATABASE_URL is empty)
AI_DB_HOST=localhost
AI_DB_PORT=5432
AI_DB_NAME=talentpredict_ai
AI_DB_USER=postgres
AI_DB_PASSWORD=
